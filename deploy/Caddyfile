{$DOMAIN} {
	encode gzip zstd

	reverse_proxy app:8080 {
		# Cloudflare proxies all traffic; pass the real visitor IP through so
		# per-IP rate limiting in the app works. If a request bypasses
		# Cloudflare the header is empty and Caddy's default XFF applies.
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto {scheme}
	}
}
